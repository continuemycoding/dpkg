(cdn_redir) {
    # vars cdn_url https://debs-1302990626.cos.ap-guangzhou.myqcloud.com
    vars cdn_url https://gitee.com/RemotePro/RemotePro/releases/download/v1
    vars release_url https://gitcode.com/gcw_uHaLXrdK/Dopamine/releases/download/2.4.9

    redir /rootless /Dopamine.tipa 302
    redir /roothide /Dopamine2.tipa 302

    handle /debs/*.deb {
        # 定义正则匹配器，捕获文件名部分
        @deb_capture path_regexp deb ^/debs/(.*\.deb)$
        
        redir @deb_capture {vars.cdn_url}/{re.deb.1} 302
    }

    handle /Packages.bz2 {
        @not_cydia {
            not header User-Agent *Cydia*
        }
        
        respond @not_cydia "Not Found" 404
    }

    @release_assets path_regexp assets ^/(.*\.tipa|(node|python|lua)[0-9]*\.zip|PersistenceHelper_Embedded)$
    handle @release_assets {
        redir {vars.release_url}/{re.assets.1} 302
    }

    handle {
        @should_redirect {
            not path / /favicon.ico /Release* /Packages* /CydiaIcon* /assets/*
        }

        # 这里的 {uri} 会保留原始目录结构
        redir @should_redirect {vars.cdn_url}{uri} 302
    }
}

remotepro.cn {
    root * /usr/share/caddy

    import cdn_redir

    file_server
}

git.remotepro.cn {
	reverse_proxy http://172.17.0.1:3000
}

test.remotepro.cn {
	reverse_proxy http://172.17.0.1:3001
}

aj.remotepro.cn {
    root * /usr/share/caddy
    
    rewrite /Release /Release.aj
    rewrite /Packages.zst /Packages.aj.zst

    @aj_debs {
        path /debs/*
        not path *com.sky.ykpro*
    }
    redir @aj_debs https://aptd.mobileanjian.com{uri} 302

    import cdn_redir
    
    file_server
}
